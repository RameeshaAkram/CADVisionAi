# ==========================================
# CADVision AI — Git Ignore Rules
# ==========================================

# ── Python Virtual Environments ───────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ── Python Bytecode & Artifacts ──────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Python Builds & Packaging ────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Node / Frontend Dependencies & Build ──
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
.turbo/

# ── Logs & Debug Outputs ─────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment & Secrets ────────────────
.env
.env*.local
*.local

# ── Application Runtime Storage ──────────
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# ── Testing, Quality & Test Reports ──────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
tests/real_world/reports/
tests/real_world/reports/dxf_cache/

# ── Scratch, Temp & Loose Test Files ─────
*.tmp
*.temp
*.bak
*~
scratch/
test*.png
test*.jpg
test*.jpeg
test*.dxf

# ── Operating System & IDE Files ─────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
